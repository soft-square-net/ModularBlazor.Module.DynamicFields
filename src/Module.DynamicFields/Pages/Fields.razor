@page "/dynamicfields"
@inherits DynamicFieldsPageBase

@*
  The tenant's fields (GET /api/dynamicfields/fields), with search and a "posts only" filter. A row opens the field in
  the builder (/dynamicfields/build?key={key}); "New field" opens an empty one. The starter library
  (GET /catalog/starter-fields) installs ready-made blocks and posts (POST /catalog/starter-fields/install).
*@

<PageHeader Title="@L["Fields"]" />

<div class="mud-container mn-page">
  <header class="mn-header">
    <div>
      <p class="mud-typography mud-typography-body1 mn-muted">
        @L["The kinds of content posts are made of. Each field is one schema.org type, with its values, its style choices and the fields it may contain. Reading needs dynamicfields.read; changing and publishing, dynamicfields.manage."]
      </p>
    </div>
    <form class="mn-actions" @onsubmit="SearchAsync" @onsubmit:preventDefault>
      <div class="mud-input-control mn-inline">
        <label class="mud-input-label" for="df-search">@L["Search"]</label>
        <div class="mud-input-wrapper mud-input-wrapper--dense">
          <input id="df-search" type="search" class="mud-input-slot" @bind="_search" placeholder="@L["key or title"]" />
        </div>
      </div>
      <label class="mn-check">
        <input type="checkbox" @bind="_postsOnly" @bind:after="SearchAsync" /> @L["Posts only"]
      </label>
      <button type="submit" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium" disabled="@Busy">@L["Search"]</button>
      <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium" @onclick="ToggleStartersAsync"
              aria-expanded="@(_starters is not null)" disabled="@Busy">@L["Starter library"]</button>
      <a href="dynamicfields/build" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium">@L["New field"]</a>
    </form>
  </header>

  @if (Error is not null)
  {
    <p class="mud-typography mud-typography-body2 mn-error" role="alert">@Error</p>
  }

  @if (_starters is not null)
  {
    <section class="mud-paper mud-elevation-2 mn-card" aria-labelledby="df-starters">
      <h2 id="df-starters" class="mud-typography mud-typography-h6">@L["Starter library"]</h2>
      <p class="mud-typography mud-typography-body2 mn-muted">
        @L["Ready-made blocks and posts, built on schema.org with the values search engines ask for marked required. Installing creates and publishes them (with the blocks a post contains); they are then yours to change. A field you have already is never overwritten."]
      </p>
      <ul class="df-starters">
        @foreach (var starter in _starters)
        {
          var s = starter;
          <li class="@(s.Installed ? "df-starter-installed" : "")">
            <label class="mn-check">
              <input type="checkbox" disabled="@s.Installed" checked="@(s.Installed || _picked.Contains(s.Key))"
                     @onchange="e => Pick(s.Key, e.Value is true)" />
              <strong>@L[s.Title]</strong>
            </label>
            <code>@s.Key</code>
            <span class="mn-chip">@s.SchemaType</span>
            @if (s.CanBeRoot) { <span class="mn-chip">@L["post"]</span> }
            @if (s.Installed) { <span class="mn-chip df-ok">@L["installed"]</span> }
            <span class="mn-muted df-starter-text">
              @if (s.Description is { } description) { @L[description] }
              @if (s.Children.Count > 0) { <text> Contains: @string.Join(", ", s.Children).</text> }
            </span>
          </li>
        }
      </ul>
      <div class="mn-row-actions">
        <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" @onclick="() => InstallAsync(_picked.ToList())"
                disabled="@(Busy || _picked.Count == 0)">Install selected (@_picked.Count)</button>
        <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium" @onclick="() => InstallAsync(null)"
                disabled="@(Busy || _starters.All(s => s.Installed))">@L["Install all missing"]</button>
        <button type="button" class="mud-button-root mud-button-text mud-button-surface mud-button-medium" @onclick="() => _starters = null">@L["Close"]</button>
      </div>
    </section>
  }

  <section class="mud-paper mud-elevation-1 mn-card">
    <MudTailDataTable @ref="_table" RowKey="key" Columns="Columns" OnRowClick="Open" EmptyText="@L["No fields yet. Install the starter library, or create one."]" />
    <div class="mn-pager">
      <span class="mud-typography mud-typography-body2 mn-muted">@PagerText</span>
      <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small" @onclick="() => GoToAsync(_page - 1)" disabled="@(Busy || _page <= 1)">@L["Previous"]</button>
      <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small" @onclick="() => GoToAsync(_page + 1)" disabled="@(Busy || _page >= LastPage)">@L["Next"]</button>
    </div>
  </section>
</div>

@code {
  private const int PageSize = 20;

  private IReadOnlyList<object> Columns =>
  [
    new { key = "key", title = L["Key"].Value },
    new { key = "title", title = L["Title"].Value },
    new { key = "type", title = L["schema.org type"].Value },
    new { key = "root", title = L["Post"].Value, width = "80px" },
    new { key = "version", title = L["Version"].Value, type = "number", width = "100px" },
    new { key = "draft", title = L["Draft"].Value, width = "120px" },
  ];

  private MudTailDataTable? _table;
  private int _page = 1;
  private int _total;
  private string _search = "";
  private bool _postsOnly;
  private IReadOnlyList<StarterFieldDto>? _starters;
  private readonly HashSet<string> _picked = [];

  private int LastPage => Math.Max(1, (_total + PageSize - 1) / PageSize);

  private string PagerText => _total == 0 ? "" : $"Page {_page} of {LastPage} ({_total} fields)";

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender) await LoadAsync();
  }

  private async Task LoadAsync()
  {
    await RunAsync(async () =>
    {
      var search = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();
      var result = await Api.ListFieldsAsync(_page, PageSize, search, _postsOnly ? true : null);
      _total = result.Total;
      if (_table is not null) await _table.SetDataAsync(result.Items.Select(ToRow).ToList());
    });
  }

  private object ToRow(FieldSummaryDto f) => new
  {
    key = f.Key,
    title = f.Title,
    type = f.SchemaType,
    root = f.CanBeRoot ? L["yes"].Value : "",
    version = f.LatestVersion == 0 ? "—" : f.LatestVersion.ToString(),
    draft = f.HasDraftChanges ? L["changed"].Value : "",
  };

  private async Task GoToAsync(int page)
  {
    _page = Math.Clamp(page, 1, LastPage);
    await LoadAsync();
  }

  private async Task SearchAsync()
  {
    _page = 1;
    await LoadAsync();
  }

  private void Open(string key) => Nav.NavigateTo($"dynamicfields/build?key={Uri.EscapeDataString(key)}");

  private async Task ToggleStartersAsync()
  {
    if (_starters is not null)
    {
      _starters = null;
      return;
    }
    await RunAsync(async () => _starters = await Api.ListStarterFieldsAsync());
  }

  private void Pick(string key, bool on)
  {
    if (on) _picked.Add(key);
    else _picked.Remove(key);
  }

  /// <summary>Installs the picked starter fields (null: every missing one), then shows what happened.</summary>
  private async Task InstallAsync(IReadOnlyList<string>? keys)
  {
    await RunAsync(async () =>
    {
      var report = await Api.InstallStarterFieldsAsync(new StarterInstall { Keys = keys });
      var parts = new List<string>();
      if (report.Installed.Count > 0) parts.Add(L["Installed {0}: {1}.", report.Installed.Count, string.Join(", ", report.Installed)]);
      if (report.Drafts.Count > 0) parts.Add(L["Created as drafts (a child field is unpublished): {0}.", string.Join(", ", report.Drafts)]);
      if (report.Skipped.Count > 0) parts.Add(L["Kept {0} you had.", report.Skipped.Count]);
      await MudTail.ToastAsync(parts.Count == 0 ? L["Nothing to install."] : string.Join(" ", parts), report.Drafts.Count > 0 ? "warning" : "success");
      _picked.Clear();
      _starters = await Api.ListStarterFieldsAsync();
    }, then: LoadAsync);
  }
}
