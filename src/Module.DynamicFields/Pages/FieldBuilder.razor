@page "/dynamicfields/build"
@using System.Text.Encodings.Web
@using System.Text.Json
@using System.Text.Json.Nodes
@using System.Text.Json.Serialization
@using soft.square.net.Module.DynamicFields.Builder
@using soft.square.net.Module.DynamicFields.Dialogs
@inherits DynamicFieldsPageBase
@inject IModuleDialogs ModuleDialogs

@*
  The field builder: a field's draft as a form. Pick a schema.org type and its suggested values are added; add more from
  the type's properties, style choices from the presets, and the fields it may contain. The preview beside it is the
  edit-content form exactly as authors will see it, with the schema.org data the values become. The draft's JSON stays
  available as the "JSON" tab. Saving and publishing go through the same API as everything else.
*@

<PageHeader Title="@(IsNew ? L["New field"] : _detail?.Draft.Title ?? FieldKey)" />

<div class="mud-container mn-page">
  <header class="mn-header df-head">
    <div>
      <a href="dynamicfields" class="mud-typography mud-typography-body2 df-back">@L["← Fields"]</a>
      <p class="mud-typography mud-typography-body2 mn-muted">
        @if (_detail is { } d)
        {
          <code>@d.Key</code>
          <span> · @(d.LatestVersion == 0 ? L["never published"] : L["published: version {0}", d.LatestVersion])</span>
          @if (Dirty) { <span class="mn-chip df-warn">@L["unsaved changes"]</span> }
          else if (d.HasDraftChanges) { <span class="mn-chip">@L["draft to publish"]</span> }
        }
        else
        {
          <span>@L["Choose what it is, then what it holds. Nothing is saved until you click Create."]</span>
        }
      </p>
    </div>
    @if (_s is not null)
    {
      <div class="mn-actions">
        <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" @onclick="SaveAsync"
                disabled="@(Busy || (!IsNew && !Dirty))">@(IsNew ? L["Create"] : L["Save draft"])</button>
        @if (_detail is { } detail)
        {
          <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium" @onclick="PublishAsync"
                  disabled="@(Busy || (!Dirty && !detail.HasDraftChanges))">@(Dirty ? L["Save and publish"] : L["Publish version {0}", detail.LatestVersion + 1])</button>
          <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-medium" @onclick="TryEditorAsync"
                  disabled="@(Busy || detail.LatestVersion == 0)" title="@L["Opens the edit-content dialog with the newest published version"]">@L["Try the editor"]</button>
          @if (detail.LatestVersion == 0)
          {
            <button type="button" class="mud-button-root mud-button-outlined mud-button-error mud-button-medium" @onclick="DeleteAsync" disabled="@Busy">@L["Delete"]</button>
          }
        }
      </div>
    }
  </header>

  @if (Error is not null)
  {
    <p class="mud-typography mud-typography-body2 mn-error" role="alert">@Error</p>
  }

  @if (_s is null || _catalog is null)
  {
    @if (Error is null) { <p class="mud-typography mud-typography-body2 mn-muted">@L["Loading…"]</p> }
  }
  else
  {
    var type = TypeOf(_s.SchemaType);
    <div class="df-builder">
      <div class="df-builder-main">
        <div class="df-tabs" role="tablist">
          <button type="button" role="tab" aria-selected="@(!_jsonTab)" class="df-tab @(!_jsonTab ? "df-tab-on" : "")" @onclick="() => _jsonTab = false">@L["Builder"]</button>
          <button type="button" role="tab" aria-selected="@_jsonTab" class="df-tab @(_jsonTab ? "df-tab-on" : "")" @onclick="OpenJson">@L["JSON"]</button>
        </div>

        @if (!_jsonTab)
        {
          @* The sections at a glance: a count each, and a mark where something still needs attention; a click goes there. *@
          <nav class="df-rail" aria-label="@L["Sections"]">
            @foreach (var step in Steps())
            {
              var st = step;
              <button type="button" class="df-rail-step @(st.Warn ? "df-rail-warn" : st.Done ? "df-rail-done" : "")" @onclick="() => GoToAsync(st.Index)"
                      title="@(st.Warn ? L["needs attention"] : st.Done ? L["done"] : "")">
                <span class="df-rail-num" aria-hidden="true">@(st.Warn ? "!" : st.Done ? "✓" : (st.Index + 1).ToString())</span>
                <span class="df-rail-label">@st.Label</span>
                @if (st.Count is { } n) { <span class="df-rail-count">@n</span> }
              </button>
            }
          </nav>
        }

        @if (_jsonTab)
        {
          <section class="mud-paper mud-elevation-1 mn-card">
            <p class="mud-typography mud-typography-body2 mn-muted">@L["The draft as the API stores it. Change it here and apply, or go back to the builder."]</p>
            <div class="mud-input-wrapper">
              <textarea class="mud-input-slot mn-body mn-code" rows="24" spellcheck="false" aria-label="@L["Draft as JSON"]" @bind="_jsonText"></textarea>
            </div>
            <div class="mn-row-actions">
              <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" @onclick="ApplyJson">@L["Apply to the builder"]</button>
            </div>
          </section>
        }
        else
        {
          @* 1. What it is *@
          <section class="mud-paper mud-elevation-1 mn-card df-section">
            <h2 class="mud-typography mud-typography-h6 df-section-title" tabindex="-1" @ref="_sections[0]">@L["1. What it is"]</h2>
            <div class="df-grid">
              @if (IsNew)
              {
                <div class="mud-input-control">
                  <label class="mud-input-label" for="fb-key">@L["Key *"]</label>
                  <div class="mud-input-wrapper"><input id="fb-key" class="mud-input-slot" @bind="_s.Key" @bind:event="oninput" maxlength="64" placeholder="block.image" /></div>
                  <div class="mud-input-helper-text">@L["Lowercase words joined by \".\" or \"-\": block.image, post.news. Content refers to it; it never changes."]</div>
                </div>
              }
              <div class="mud-input-control">
                <label class="mud-input-label" for="fb-title">@L["Title *"]</label>
                <div class="mud-input-wrapper"><input id="fb-title" class="mud-input-slot" @bind="_s.Title" @bind:event="oninput" maxlength="120" placeholder="@L["Image"]" /></div>
                <div class="mud-input-helper-text">@L["What authors see in menus: \"Image\", \"News story\"."]</div>
              </div>
            </div>
            <div class="mud-input-control">
              <label class="mud-input-label" for="fb-type">@L["schema.org type *"]</label>
              <div class="mud-input-wrapper mud-input-wrapper--select">
                <select id="fb-type" class="mud-input-slot" @bind="_s.SchemaType" @bind:after="TypeChanged">
                  @foreach (var family in Families)
                  {
                    <optgroup label="@family.Name">
                      @foreach (var t in family.Types)
                      {
                        <option value="@t.Name">@(new string(' ', 3 * Math.Max(0, t.Path.Count - 2)))@t.Name</option>
                      }
                    </optgroup>
                  }
                </select>
              </div>
              @if (type is not null)
              {
                <div class="mud-input-helper-text">
                  @type.Description
                  <span class="df-path">@string.Join(" › ", type.Path)</span>
                  <a href="@($"https://schema.org/{type.Name}")" target="_blank" rel="noopener">schema.org/@type.Name</a>
                </div>
              }
            </div>
            <div class="mud-input-control">
              <label class="mud-input-label" for="fb-description">@L["Description"]</label>
              <div class="mud-input-wrapper"><textarea id="fb-description" class="mud-input-slot" rows="2" maxlength="1000" @bind="_s.Description" @bind:event="oninput"></textarea></div>
              <div class="mud-input-helper-text">@L["When to use it; authors see it in the editor."]</div>
            </div>
            <label class="mn-check"><input type="checkbox" @bind="_s.CanBeRoot" /> @L["A post can be made of it (a root, with no parent): an article, a news story, a gallery page."]</label>
            @if (_s.CanBeRoot)
            {
              var suggested = FieldBuilderState.SuggestUrlPrefix(_s.Key);
              <div class="mud-input-control df-url-prefix">
                <label class="mud-input-label" for="fb-url-prefix">@L["URL prefix *"]</label>
                <div class="mud-input-wrapper">
                  <span class="mn-muted" aria-hidden="true">/</span>
                  <input id="fb-url-prefix" class="mud-input-slot" dir="ltr" @bind="_s.UrlPrefix" @bind:event="oninput" maxlength="200"
                         placeholder="@suggested" aria-invalid="@(!_s.UrlPrefixIsValid)" aria-describedby="fb-url-prefix-help" />
                  <span class="mn-muted" aria-hidden="true">/…</span>
                </div>
                <div id="fb-url-prefix-help" class="mud-input-helper-text">@L["The public address of posts of this kind: \"news\" gives /news/…. Lowercase words (a-z, 0-9, \"-\") separated by \"/\", e.g. news or ar/news. Needed to publish; no other post field may use it."]</div>
                @if (!_s.UrlPrefixIsValid)
                {
                  <div class="mud-input-helper-text mn-error" role="alert">@L["A URL prefix is lowercase letters, digits and single hyphens, with \"/\" between its parts and none at either end."]</div>
                }
                else if (string.IsNullOrWhiteSpace(_s.UrlPrefix))
                {
                  <div class="mn-row-actions">
                    <button type="button" class="mud-button-root mud-button-text mud-button-small" @onclick="() => _s.UrlPrefix = suggested">@L["Use /{0}", suggested]</button>
                  </div>
                }
              </div>
            }
          </section>

          @* 2. Values *@
          <section class="mud-paper mud-elevation-1 mn-card df-section">
            <h2 class="mud-typography mud-typography-h6 df-section-title" tabindex="-1" @ref="_sections[1]">@L["2. Values"] <span class="mn-muted df-count">@_s.Properties.Count</span></h2>
            <p class="mud-typography mud-typography-body2 mn-muted">@L["What an author fills in. Each value is published as a schema.org property, which is what search engines and AI read."]</p>

            @if (_s.CanBeRoot)
            {
              <div class="df-groups">
                <strong class="mud-typography mud-typography-subtitle2">@L["Value groups"]</strong>
                <p class="mud-typography mud-typography-body2 mn-muted">@L["Optional: sort a post's values into groups, such as the story and search and sharing, so each can be edited and routed apart (the SEO section gets its group). A value with no group is in the first."]</p>
                @foreach (var group in _s.Groups)
                {
                  var g = group;
                  var gid = $"fb-g-{_s.Groups.IndexOf(g)}";
                  <div class="df-grid df-group-row" @key="g">
                    <div class="mud-input-control">
                      <label class="mud-input-label" for="@($"{gid}-label")">@L["Label *"]</label>
                      <div class="mud-input-wrapper"><input id="@($"{gid}-label")" class="mud-input-slot" @bind="g.Label" @bind:event="oninput" maxlength="120" /></div>
                    </div>
                    <div class="mud-input-control">
                      <label class="mud-input-label" for="@($"{gid}-key")">@L["Key *"]</label>
                      <div class="mud-input-wrapper"><input id="@($"{gid}-key")" class="mud-input-slot" @bind="g.Key" @bind:event="oninput" maxlength="64" /></div>
                    </div>
                    <div class="mud-input-control">
                      <label class="mud-input-label" for="@($"{gid}-help")">@L["Description"]</label>
                      <div class="mud-input-wrapper"><input id="@($"{gid}-help")" class="mud-input-slot" @bind="g.Description" @bind:event="oninput" maxlength="500" /></div>
                    </div>
                    <span class="df-row-tools">
                      <button type="button" class="mud-button-root mud-button-text mud-button-small" aria-label="@L["Move up"]" title="@L["Move up"]" @onclick="() => FieldBuilderState.Move(_s.Groups, g, -1)">↑</button>
                      <button type="button" class="mud-button-root mud-button-text mud-button-small" aria-label="@L["Move down"]" title="@L["Move down"]" @onclick="() => FieldBuilderState.Move(_s.Groups, g, 1)">↓</button>
                      <button type="button" class="mud-button-root mud-button-text mud-button-small" aria-label="@L["Remove"]" title="@L["Remove"]" @onclick="() => _s.Groups.Remove(g)">✕</button>
                    </span>
                  </div>
                }
                <div class="mn-row-actions">
                  @if (_s.Groups.Count == 0)
                  {
                    <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small" @onclick="AddStoryAndSeo">@L["Add Story and SEO groups"]</button>
                  }
                  <button type="button" class="mud-button-root mud-button-text mud-button-primary mud-button-small" @onclick="AddGroup">@L["Add a group"]</button>
                </div>
              </div>
            }

            @foreach (var row in _s.Properties)
            {
              var r = row;
              <div class="df-row @(r.Open ? "df-row-open" : "") @(NeedsAttention(r) ? "df-row-warn" : r.Required ? "df-row-required" : "")" @key="r">
                <div class="df-row-head">
                  <button type="button" class="df-row-toggle" aria-expanded="@r.Open" @onclick="() => r.Open = !r.Open">
                    <span class="df-caret" aria-hidden="true">▸</span>
                    <strong>@(r.Label.Length > 0 ? r.Label : "(no label)")</strong>
                    <span class="mn-chip">@KindLabel(r.Kind)@(r.Multiple ? " · list" : "")</span>
                    @if (r.Required) { <span class="mn-chip df-required">@L["required"]</span> }
                    @if (_s.GroupOf(r) is { } inGroup) { <span class="mn-chip">@GroupLabel(inGroup)</span> }
                    @if (r.SchemaProperty is { Length: > 0 } sp) { <span class="df-schema">schema.org: @sp</span> }
                    else { <span class="df-schema df-warn-text">@L["no schema.org property"]</span> }
                  </button>
                  <span class="df-row-tools">
                    <button type="button" class="mud-button-root mud-button-text mud-button-small" aria-label="@L["Move up"]" title="@L["Move up"]" @onclick="() => FieldBuilderState.Move(_s.Properties, r, -1)">↑</button>
                    <button type="button" class="mud-button-root mud-button-text mud-button-small" aria-label="@L["Move down"]" title="@L["Move down"]" @onclick="() => FieldBuilderState.Move(_s.Properties, r, 1)">↓</button>
                    <button type="button" class="mud-button-root mud-button-text mud-button-small" aria-label="@L["Remove"]" title="@L["Remove"]" @onclick="() => _s.Properties.Remove(r)">✕</button>
                  </span>
                </div>
                @if (r.Open)
                {
                  var id = $"fb-p-{_s.Properties.IndexOf(r)}";
                  <div class="df-row-body">
                    <div class="df-grid">
                      <div class="mud-input-control">
                        <label class="mud-input-label" for="@($"{id}-label")">@L["Label *"]</label>
                        <div class="mud-input-wrapper"><input id="@($"{id}-label")" class="mud-input-slot" @bind="r.Label" @bind:event="oninput" maxlength="120" /></div>
                      </div>
                      <div class="mud-input-control">
                        <label class="mud-input-label" for="@($"{id}-key")">@L["Key *"]</label>
                        <div class="mud-input-wrapper"><input id="@($"{id}-key")" class="mud-input-slot" @bind="r.Key" @bind:event="oninput" maxlength="64" /></div>
                        <div class="mud-input-helper-text">@L["camelCase; content stores the value under it. Keep it once published."]</div>
                      </div>
                      <div class="mud-input-control">
                        <label class="mud-input-label" for="@($"{id}-kind")">@L["Kind"]</label>
                        <div class="mud-input-wrapper mud-input-wrapper--select">
                          <select id="@($"{id}-kind")" class="mud-input-slot" @bind="r.Kind">
                            @foreach (var kind in Enum.GetValues<PropertyKind>())
                            {
                              <option value="@kind">@KindLabel(kind)</option>
                            }
                          </select>
                        </div>
                      </div>
                      <div class="mud-input-control">
                        <label class="mud-input-label" for="@($"{id}-schema")">@L["schema.org property"]</label>
                        <div class="mud-input-wrapper mud-input-wrapper--select">
                          <select id="@($"{id}-schema")" class="mud-input-slot" @bind="r.SchemaProperty">
                            <option value="">@L["(none)"]</option>
                            @if (r.SchemaProperty is { Length: > 0 } current && type?.Properties.Contains(current) != true)
                            {
                              <option value="@current">@current</option>
                            }
                            @foreach (var name in type?.Properties ?? [])
                            {
                              <option value="@name">@name</option>
                            }
                          </select>
                        </div>
                      </div>
                    </div>
                    @if (_s.Grouped)
                    {
                      <div class="mud-input-control">
                        <label class="mud-input-label" for="@($"{id}-group")">@L["Group"]</label>
                        <div class="mud-input-wrapper mud-input-wrapper--select">
                          <select id="@($"{id}-group")" class="mud-input-slot" value="@_s.GroupOf(r)" @onchange="e => r.Group = e.Value?.ToString()">
                            @foreach (var g in _s.Groups)
                            {
                              <option value="@g.Key.Trim()">@(g.Label.Trim().Length > 0 ? g.Label : g.Key)</option>
                            }
                          </select>
                        </div>
                      </div>
                    }
                    <div class="df-checks">
                      <label class="mn-check"><input type="checkbox" @bind="r.Required" /> @L["Required"]</label>
                      <label class="mn-check"><input type="checkbox" @bind="r.Multiple" /> @L["A list (several values)"]</label>
                      @if (r.IsText)
                      {
                        <label class="mn-check" title="@L["Off for text that is not language, such as a code or a slug."]"><input type="checkbox" @bind="r.Translatable" /> @L["Translated per language"]</label>
                      }
                    </div>
                    <div class="mud-input-control">
                      <label class="mud-input-label" for="@($"{id}-help")">@L["Help text"]</label>
                      <div class="mud-input-wrapper"><input id="@($"{id}-help")" class="mud-input-slot" @bind="r.HelpText" @bind:event="oninput" maxlength="500" /></div>
                    </div>
                    @if (r.IsText)
                    {
                      <div class="df-grid">
                        <div class="mud-input-control">
                          <label class="mud-input-label" for="@($"{id}-minlen")">@L["Minimum length"]</label>
                          <div class="mud-input-wrapper"><input id="@($"{id}-minlen")" type="number" min="0" step="1" class="mud-input-slot" @bind="r.MinLength" /></div>
                        </div>
                        <div class="mud-input-control">
                          <label class="mud-input-label" for="@($"{id}-maxlen")">@L["Maximum length"]</label>
                          <div class="mud-input-wrapper"><input id="@($"{id}-maxlen")" type="number" min="1" step="1" class="mud-input-slot" @bind="r.MaxLength" /></div>
                        </div>
                      </div>
                    }
                    @if (r.IsNumber)
                    {
                      <div class="df-grid">
                        <div class="mud-input-control">
                          <label class="mud-input-label" for="@($"{id}-min")">@L["Minimum"]</label>
                          <div class="mud-input-wrapper"><input id="@($"{id}-min")" type="number" step="any" class="mud-input-slot" @bind="r.Minimum" /></div>
                        </div>
                        <div class="mud-input-control">
                          <label class="mud-input-label" for="@($"{id}-max")">@L["Maximum"]</label>
                          <div class="mud-input-wrapper"><input id="@($"{id}-max")" type="number" step="any" class="mud-input-slot" @bind="r.Maximum" /></div>
                        </div>
                      </div>
                    }
                    @if (r.Kind == PropertyKind.Choice)
                    {
                      <div class="mud-input-control">
                        <label class="mud-input-label" for="@($"{id}-options")">@L["Options *"]</label>
                        <div class="mud-input-wrapper"><textarea id="@($"{id}-options")" class="mud-input-slot" rows="3" @bind="r.OptionsText" @bind:event="oninput" placeholder="@L["One per line"]"></textarea></div>
                      </div>
                    }
                    @if (r.Kind == PropertyKind.Asset)
                    {
                      <div class="mud-input-control">
                        <label class="mud-input-label" for="@($"{id}-accept")">@L["Accepted files"]</label>
                        <div class="mud-input-wrapper"><input id="@($"{id}-accept")" class="mud-input-slot" @bind="r.AcceptText" @bind:event="oninput" placeholder="@L["Any file"]" /></div>
                        <p class="mud-input-helper-text">@L["Content types, families or extensions, separated by commas: image/*, video/mp4, .pdf. Empty: any file."]</p>
                      </div>
                      <div class="df-accept-presets" role="group" aria-label="@L["Accepted files"]">
                        @foreach (var preset in AcceptPresets)
                        {
                          var on = r.AcceptList.SequenceEqual(preset.Accept);
                          <button type="button" class="mn-chip" aria-pressed="@(on ? "true" : "false")"
                                  @onclick="() => SetAccept(r, preset.Accept)">@L[preset.Label]</button>
                        }
                      </div>
                    }
                    @if (r.Kind is PropertyKind.Asset or PropertyKind.Keyword or PropertyKind.Term)
                    {
                      <p class="mud-typography mud-typography-body2 mn-muted">
                        @(r.Kind switch { PropertyKind.Asset => L["Authors choose it in the file browser of the Storage module (or the Media module's picker) when it is installed, or type its id."], PropertyKind.Keyword => L["Authors pick it with the Keywords module's picker when it is installed, or type its id."], _ => L["Authors pick it with the Taxonomies module's picker when it is installed, or type its id."] })
                      </p>
                    }
                    @if (r.IsLookup)
                    {
                      <LookupBindingEditor Row="r" Others="_s.Properties" Id="@id" />
                    }
                  </div>
                }
              </div>
            }

            <div class="df-suggest">
              <div class="df-suggest-head">
                <strong class="mud-typography mud-typography-subtitle2">@L["Add from schema.org {0}", _s.SchemaType]</strong>
                <div class="mud-input-wrapper mud-input-wrapper--dense df-filter">
                  <input type="search" class="mud-input-slot" aria-label="@L["Filter schema.org properties"]" placeholder="@L["Filter"]" @bind="_propertyFilter" @bind:event="oninput" />
                </div>
                @if (MissingSuggested.Count > 0)
                {
                  <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small" @onclick="AddSuggested">
                    @L["Add the suggested ({0})", MissingSuggested.Count]
                  </button>
                }
                <button type="button" class="mud-button-root mud-button-text mud-button-primary mud-button-small" @onclick="AddCustomProperty">@L["Add a custom value"]</button>
              </div>
              <ul class="df-suggest-list">
                @foreach (var p in AvailableProperties)
                {
                  var prop = p;
                  <li>
                    <button type="button" class="mud-button-root mud-button-text mud-button-primary mud-button-small" @onclick="() => AddFromSchema(prop)"
                            aria-label="@L["Add {0}", prop.Label]">＋</button>
                    <span class="df-suggest-name">@prop.Label @if (type?.Suggested.Contains(prop.Name) == true) { <span class="mn-chip df-star" title="@L["Suggested for this type"]">@L["suggested"]</span> }</span>
                    <code>@prop.Name</code>
                    <span class="mn-chip">@KindLabel(prop.Kind)@(prop.Multiple == true ? " · " + L["list"] : "")</span>
                    <span class="mn-muted df-suggest-help">@prop.Description</span>
                  </li>
                }
                @if (!AvailableProperties.Any())
                {
                  <li class="mn-muted">@(string.IsNullOrWhiteSpace(_propertyFilter) ? L["Every property of {0} is already used.", _s.SchemaType] : L["Every property of {0} matching the filter is already used.", _s.SchemaType])</li>
                }
              </ul>
            </div>
          </section>

          @* 3. Style *@
          <section class="mud-paper mud-elevation-1 mn-card df-section">
            <h2 class="mud-typography mud-typography-h6 df-section-title" tabindex="-1" @ref="_sections[2]">@L["3. Style"] <span class="mn-muted df-count">@_s.Style.Count</span></h2>
            <p class="mud-typography mud-typography-body2 mn-muted">@L["Choices from the theme's tokens, never free CSS. A responsive one can differ per screen size."]</p>
            @foreach (var row in _s.Style)
            {
              var r = row;
              <div class="df-row @(r.Open ? "df-row-open" : "")" @key="r">
                <div class="df-row-head">
                  <button type="button" class="df-row-toggle" aria-expanded="@r.Open" @onclick="() => r.Open = !r.Open">
                    <span class="df-caret" aria-hidden="true">▸</span>
                    <strong>@(r.Label.Length > 0 ? r.Label : "(no label)")</strong>
                    <span class="df-schema">@string.Join(" · ", r.Values)</span>
                    @if (r.Responsive) { <span class="mn-chip">@L["responsive"]</span> }
                  </button>
                  <span class="df-row-tools">
                    <button type="button" class="mud-button-root mud-button-text mud-button-small" aria-label="@L["Move up"]" title="@L["Move up"]" @onclick="() => FieldBuilderState.Move(_s.Style, r, -1)">↑</button>
                    <button type="button" class="mud-button-root mud-button-text mud-button-small" aria-label="@L["Move down"]" title="@L["Move down"]" @onclick="() => FieldBuilderState.Move(_s.Style, r, 1)">↓</button>
                    <button type="button" class="mud-button-root mud-button-text mud-button-small" aria-label="@L["Remove"]" title="@L["Remove"]" @onclick="() => _s.Style.Remove(r)">✕</button>
                  </span>
                </div>
                @if (r.Open)
                {
                  var id = $"fb-s-{_s.Style.IndexOf(r)}";
                  <div class="df-row-body">
                    <div class="df-grid">
                      <div class="mud-input-control">
                        <label class="mud-input-label" for="@($"{id}-label")">@L["Label *"]</label>
                        <div class="mud-input-wrapper"><input id="@($"{id}-label")" class="mud-input-slot" @bind="r.Label" @bind:event="oninput" maxlength="120" /></div>
                      </div>
                      <div class="mud-input-control">
                        <label class="mud-input-label" for="@($"{id}-key")">@L["Key *"]</label>
                        <div class="mud-input-wrapper"><input id="@($"{id}-key")" class="mud-input-slot" @bind="r.Key" @bind:event="oninput" maxlength="64" /></div>
                      </div>
                    </div>
                    <div class="mud-input-control">
                      <label class="mud-input-label" for="@($"{id}-values")">@L["Tokens *"]</label>
                      <div class="mud-input-wrapper"><input id="@($"{id}-values")" class="mud-input-slot" @bind="r.ValuesText" @bind:event="oninput" placeholder="@L["full, wide, half"]" /></div>
                      <div class="mud-input-helper-text">@L["Separated by commas; letters, digits, \"%\", \".\", \"_\" and \"-\". The theme maps each to CSS."]</div>
                    </div>
                    <div class="df-grid">
                      <div class="mud-input-control">
                        <label class="mud-input-label" for="@($"{id}-default")">@L["Default"]</label>
                        <div class="mud-input-wrapper mud-input-wrapper--select">
                          <select id="@($"{id}-default")" class="mud-input-slot" @bind="r.Default">
                            <option value="">@L["(none)"]</option>
                            @foreach (var token in r.Values) { <option value="@token">@token</option> }
                          </select>
                        </div>
                      </div>
                      <label class="mn-check df-check-cell"><input type="checkbox" @bind="r.Responsive" /> @L["Can differ per screen size"]</label>
                    </div>
                  </div>
                }
              </div>
            }
            <div class="df-presets">
              <span class="mud-typography mud-typography-body2 mn-muted">@L["Add:"]</span>
              @foreach (var preset in _catalog.StylePresets.Where(p => _s.Style.All(s => s.Key != p.Key)))
              {
                var pr = preset;
                <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small" @onclick="() => _s.Style.Add(FieldBuilderState.StyleRow.From(pr))"
                        title="@string.Join(", ", pr.Values)">＋ @pr.Label</button>
              }
              <button type="button" class="mud-button-root mud-button-text mud-button-primary mud-button-small" @onclick="AddCustomStyle">@L["Add a custom style"]</button>
            </div>
          </section>

          @* 4. Children *@
          <section class="mud-paper mud-elevation-1 mn-card df-section">
            <h2 class="mud-typography mud-typography-h6 df-section-title" tabindex="-1" @ref="_sections[3]">@L["4. What it can contain"] <span class="mn-muted df-count">@_s.Children.Count</span></h2>
            <p class="mud-typography mud-typography-body2 mn-muted">
              @L["The fields an author can add inside it, and how many: a post holds paragraphs and images, a gallery holds images. Publishing pins each to its newest published version."]
            </p>
            @if (_s.Children.Count > 0)
            {
              <table class="df-children">
                <thead><tr><th scope="col">@L["Field"]</th><th scope="col">@L["At least"]</th><th scope="col">@L["At most"]</th><th scope="col"><span class="mn-sr-only">@L["Remove"]</span></th></tr></thead>
                <tbody>
                  @foreach (var child in _s.Children)
                  {
                    var c = child;
                    var info = _fields.FirstOrDefault(f => f.Key == c.FieldKey);
                    <tr @key="c">
                      <td>
                        <div class="mud-input-wrapper mud-input-wrapper--dense mud-input-wrapper--select">
                        <select class="mud-input-slot" aria-label="@L["Child field"]" @bind="c.FieldKey">
                          @if (info is null) { <option value="@c.FieldKey">@c.FieldKey (not found)</option> }
                          @foreach (var f in _fields.Where(f => f.Key != _s.Key && (f.Key == c.FieldKey || _s.Children.All(x => x.FieldKey != f.Key))))
                          {
                            <option value="@f.Key">@f.Title (@f.Key)</option>
                          }
                        </select>
                        </div>
                        @if (info is { LatestVersion: 0 }) { <span class="mn-chip df-warn" title="@L["Publish it before publishing this field"]">@L["not published"]</span> }
                      </td>
                      <td><div class="mud-input-wrapper mud-input-wrapper--dense df-num"><input type="number" min="0" step="1" class="mud-input-slot" aria-label="@L["At least"]" @bind="c.Min" /></div></td>
                      <td><div class="mud-input-wrapper mud-input-wrapper--dense df-num"><input type="number" min="1" step="1" class="mud-input-slot" aria-label="@L["At most (empty: any number)"]" placeholder="any" @bind="c.Max" /></div></td>
                      <td><button type="button" class="mud-button-root mud-button-text mud-button-small" aria-label="@L["Remove"]" @onclick="() => _s.Children.Remove(c)">✕</button></td>
                    </tr>
                  }
                </tbody>
              </table>
            }
            @if (ChildCandidates.Any())
            {
              <div class="df-presets">
                <span class="mud-typography mud-typography-body2 mn-muted">@L["Add:"]</span>
                @foreach (var f in ChildCandidates)
                {
                  var field = f;
                  <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small"
                          @onclick="() => _s.Children.Add(new FieldBuilderState.ChildRow { FieldKey = field.Key })" title="@field.Key">＋ @field.Title</button>
                }
              </div>
            }
            else if (_s.Children.Count == 0)
            {
              <p class="mud-typography mud-typography-body2 mn-muted">@L["No other fields yet. Create some, or install the starter library from the Fields page."]</p>
            }
          </section>

          <details class="mud-paper mud-elevation-1 mn-card df-section" open="@_advancedOpen">
            <summary class="mud-typography mud-typography-subtitle2 df-section-title" tabindex="-1" @ref="_sections[4]" @onclick="() => _advancedOpen = !_advancedOpen" @onclick:preventDefault>@L["Advanced"]</summary>
            <div class="mud-input-control">
              <label class="mud-input-label" for="fb-dialog">@L["Editor dialog"]</label>
              <div class="mud-input-wrapper"><input id="fb-dialog" class="mud-input-slot" @bind="_s.EditorDialog" maxlength="128" placeholder="@L["Module.Media/edit-image"]" /></div>
              <div class="mud-input-helper-text">@L["Another module's dialog that edits this field instead of the generic editor. Empty: the generic one."]</div>
            </div>
          </details>
        }

        @if (_tried is not null)
        {
          <section class="mud-paper mud-elevation-1 mn-card">
            <h2 class="mud-typography mud-typography-subtitle2">@L["What the editor returned"]</h2>
            <pre class="mn-result">@_tried</pre>
            <div class="mn-row-actions">
              <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small" @onclick="TryTranslationAsync"
                      title="@L["Opens the translate-content dialog with this content, into the other language"]">@L["Try translating"]</button>
            </div>
            @if (_translated is not null)
            {
              <h2 class="mud-typography mud-typography-subtitle2">@L["What the translator returned"]</h2>
              <pre class="mn-result">@_translated</pre>
            }
          </section>
        }
      </div>

      <aside class="df-builder-preview" aria-label="@L["Preview"]">
        <section class="mud-paper mud-elevation-2 mn-card df-preview-card">
          <h2 class="mud-typography mud-typography-h6 df-preview-title">@L["Preview"] <span class="df-live" aria-hidden="true">@L["Live"]</span></h2>
          <p class="mud-typography mud-typography-body2 mn-muted">@L["The editor as authors will see it. Try it: values you type here are not saved."]</p>
          @* The form updates its own state; these let the page re-render too, so the schema.org data below follows. *@
          <div class="df-editor df-preview" @oninput="PreviewChanged" @onchange="PreviewChanged" @onclick="PreviewChanged">
            <ContentEditorForm State="Preview" Issues="_previewIssues" StyleOpen="true" />
          </div>
          <div class="mn-row-actions">
            <button type="button" class="mud-button-root mud-button-outlined mud-button-primary mud-button-small" @onclick="CheckPreview">@L["Check required values"]</button>
          </div>
          <h3 class="mud-typography mud-typography-subtitle2">@L["As schema.org data"]</h3>
          <p class="mud-typography mud-typography-body2 mn-muted">@L["What search engines and AI read from it (JSON-LD), as the server builds it; ‹…› marks a value not filled in."]</p>
          <pre class="mn-result df-jsonld">@(_jsonLd ?? L["Building…"])</pre>
        </section>
      </aside>
    </div>
  }
</div>

@code {
  /// <summary>
  /// The field to open (?key=block.image); none: a new field. A query value, not a path segment: keys contain dots, and
  /// a host takes a last segment with a dot for a file, so /build/block.image would not reach the app on a reload.
  /// </summary>
  [SupplyParameterFromQuery(Name = "key")] public string? FieldKey { get; set; }

  private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web)
  {
    WriteIndented = true,
    Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping, // shown as text
    Converters = { new JsonStringEnumConverter() },
    DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
  };

  private sealed record Family(string Name, IReadOnlyList<SchemaTypeDto> Types);

  // ───────────── the section bar ─────────────

  private readonly ElementReference[] _sections = new ElementReference[5];
  private bool _advancedOpen;

  private sealed record Step(int Index, string Label, int? Count, bool Done, bool Warn);

  /// <summary>A value an author or a search engine would miss: no label, or no schema.org property.</summary>
  private static bool NeedsAttention(FieldBuilderState.PropertyRow row) =>
    row.Label.Trim().Length == 0 || string.IsNullOrWhiteSpace(row.SchemaProperty);

  private IEnumerable<Step> Steps()
  {
    if (_s is null) yield break;
    var basics = _s.Title.Trim().Length > 0 && (!IsNew || _s.Key.Trim().Length > 0)
      && (!_s.CanBeRoot || (_s.UrlPrefixIsValid && !string.IsNullOrWhiteSpace(_s.UrlPrefix)));
    yield return new(0, L["What it is"], null, basics, false);
    yield return new(1, L["Values"], _s.Properties.Count, _s.Properties.Count > 0, _s.Properties.Any(NeedsAttention));
    yield return new(2, L["Style"], _s.Style.Count, _s.Style.Count > 0, false);
    yield return new(3, L["What it can contain"], _s.Children.Count, _s.Children.Count > 0,
      _s.Children.Any(c => _fields.FirstOrDefault(f => f.Key == c.FieldKey) is not { LatestVersion: > 0 }));
    yield return new(4, L["Advanced"], null, !string.IsNullOrWhiteSpace(_s.EditorDialog), false);
  }

  /// <summary>Brings a section into view: focusing its heading scrolls to it (below the sticky header) and reads it out.</summary>
  private async Task GoToAsync(int index)
  {
    if (index == 4 && !_advancedOpen)
    {
      _advancedOpen = true;
      StateHasChanged();
      await Task.Yield();
    }
    try { await _sections[index].FocusAsync(preventScroll: false); }
    catch (InvalidOperationException) { } // not rendered yet
  }

  private static SchemaOrgCatalogDto? _catalog; // the same for every tenant: loaded once
  private FieldBuilderState? _s;
  private FieldDetailDto? _detail;
  private IReadOnlyList<FieldSummaryDto> _fields = [];
  private string? _savedSignature;
  private string _propertyFilter = "";
  private bool _jsonTab;
  private string _jsonText = "";
  private string? _tried;
  private string? _translated;

  private ContentEditorState? _preview;
  private string? _previewSignature;
  private Dictionary<string, string> _previewIssues = [];

  private bool IsNew => _detail is null;
  private bool Dirty => _s is not null && Signature() != _savedSignature;

  protected override async Task OnParametersSetAsync()
  {
    if (_s is not null && FieldKey is not null && FieldKey == _detail?.Key) return; // we just created it and moved here
    _jsonTab = false;
    _tried = null;
    _translated = null;
    await RunAsync(async () =>
    {
      _catalog ??= await Api.GetSchemaOrgCatalogAsync();
      _fields = (await Api.ListFieldsAsync(1, 100, null, null)).Items;
      if (FieldKey is null)
      {
        _detail = null;
        _s = new FieldBuilderState();
      }
      else
      {
        _detail = await Api.GetFieldAsync(FieldKey);
        _s = FieldBuilderState.From(_detail.Key, _detail.Draft);
      }
      _savedSignature = Signature();
      _preview = null;
    }, toast: false);
  }

  private string Signature() => _s is null ? "" : _s.Key + "\n" + JsonSerializer.Serialize(_s.ToDraft(), Json);

  // ------------------------------------------------------------------ catalog

  private SchemaTypeDto? TypeOf(string? name) => _catalog?.Types.FirstOrDefault(t => t.Name == name);

  private SchemaOrgProperty? PropertyOf(string name) => _catalog?.Properties.FirstOrDefault(p => p.Name == name);

  /// <summary>The types by family (Article, MediaObject, WebPage, ...); single types together under "Other works".</summary>
  private IEnumerable<Family> Families
  {
    get
    {
      var groups = _catalog!.Types.GroupBy(t => t.Path.Count > 1 ? t.Path[1] : t.Name).ToList();
      foreach (var group in groups.Where(g => g.Count() > 1)) yield return new Family(group.Key, [.. group]);
      yield return new Family(L["Other works"], [.. groups.Where(g => g.Count() == 1).SelectMany(g => g)]);
    }
  }

  /// <summary>The type's properties no value is published as yet, matching the filter; suggested ones first.</summary>
  private IEnumerable<SchemaOrgProperty> AvailableProperties
  {
    get
    {
      var type = TypeOf(_s!.SchemaType);
      if (type is null) return [];
      var used = _s.Properties.Select(p => p.SchemaProperty).ToHashSet();
      var filter = _propertyFilter.Trim();
      return type.Properties
        .Where(n => !used.Contains(n))
        .Select(PropertyOf).OfType<SchemaOrgProperty>()
        .Where(p => filter.Length == 0 || p.Name.Contains(filter, StringComparison.OrdinalIgnoreCase) || p.Label.Contains(filter, StringComparison.OrdinalIgnoreCase))
        .OrderBy(p => type.Suggested.Contains(p.Name) ? 0 : 1);
    }
  }

  private IReadOnlyList<string> MissingSuggested
  {
    get
    {
      var used = _s!.Properties.Select(p => p.SchemaProperty).ToHashSet();
      return [.. (TypeOf(_s.SchemaType)?.Suggested ?? []).Where(n => !used.Contains(n))];
    }
  }

  private IEnumerable<FieldSummaryDto> ChildCandidates =>
    _fields.Where(f => f.Key != _s!.Key.Trim() && _s.Children.All(c => c.FieldKey != f.Key));

  /// <summary>A new field takes its type's suggested values; a field with values keeps them (the button adds the rest).</summary>
  private void TypeChanged()
  {
    if (_s!.Properties.Count == 0) AddSuggested();
    if (_s.Title.Trim().Length == 0) _s.Title = Humanize(_s.SchemaType);
  }

  private void AddSuggested()
  {
    foreach (var name in MissingSuggested)
      if (PropertyOf(name) is { } p) AddFromSchema(p, open: false);
  }

  private void AddFromSchema(SchemaOrgProperty p) => AddFromSchema(p, open: true);

  private void AddFromSchema(SchemaOrgProperty p, bool open)
  {
    var row = FieldBuilderState.PropertyRow.From(p, FieldBuilderState.FreeKey(p.Name, _s!.Properties.Select(r => r.Key)),
      TypeOf(_s.SchemaType)?.ContentAccept);
    row.Open = open;
    _s.Properties.Add(row);
  }

  private void AddCustomProperty() => _s!.Properties.Add(new FieldBuilderState.PropertyRow
  {
    Key = FieldBuilderState.FreeKey("value", _s.Properties.Select(r => r.Key)),
    Label = L["New value"],
    Open = true
  });

  private void AddCustomStyle() => _s!.Style.Add(new FieldBuilderState.StyleRow
  {
    Key = FieldBuilderState.FreeKey("variant", _s.Style.Select(r => r.Key)),
    Label = L["Variant"],
    ValuesText = "default, alternate",
    Default = "default",
    Open = true
  });

  /// <summary>The usual split of a post's values: the story, and what the SEO section looks after.</summary>
  private void AddStoryAndSeo()
  {
    _s!.Groups.Add(new FieldBuilderState.GroupRow { Key = "main", Label = L["Story"], Description = L["The headline, the main image, who wrote it and when."] });
    _s.Groups.Add(new FieldBuilderState.GroupRow { Key = "seo", Label = L["Search and sharing"], Description = L["The summary and keywords search engines and link previews show."] });
    foreach (var row in _s.Properties.Where(r => r.SchemaProperty is "description" or "keywords" or "alternativeHeadline"))
      row.Group = "seo";
  }

  private void AddGroup() => _s!.Groups.Add(new FieldBuilderState.GroupRow
  {
    Key = FieldBuilderState.FreeKey("group", _s.Groups.Select(g => g.Key)),
    Label = L["New group"]
  });

  private string GroupLabel(string key) =>
    _s!.Groups.FirstOrDefault(g => g.Key.Trim() == key) is { Label: { Length: > 0 } label } ? label : key;

  /// <summary>The accept lists offered as one click on an Asset value.</summary>
  private static readonly (string Label, string[] Accept)[] AcceptPresets =
  [
    ("Any file", []),
    ("Images", ["image/*"]),
    ("Video", ["video/*"]),
    ("Audio", ["audio/*"]),
    ("Documents", [".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".odt", ".txt"])
  ];

  private static void SetAccept(FieldBuilderState.PropertyRow row, string[] accept) => row.AcceptText = string.Join(", ", accept);

  private static string Humanize(string type) =>
    string.Concat(type.Select((c, i) => i > 0 && char.IsUpper(c) && !char.IsUpper(type[i - 1]) ? $" {char.ToLowerInvariant(c)}" : c.ToString()));

  private string KindLabel(PropertyKind kind) => L[kind switch
  {
    PropertyKind.Text => "Text",
    PropertyKind.RichText => "Formatted text",
    PropertyKind.Integer => "Whole number",
    PropertyKind.Decimal => "Number",
    PropertyKind.Boolean => "Yes / no",
    PropertyKind.Date => "Date",
    PropertyKind.DateTime => "Date and time",
    PropertyKind.Url => "Web address",
    PropertyKind.Choice => "Choice",
    PropertyKind.Asset => "File or media",
    PropertyKind.Keyword => "Keyword",
    PropertyKind.Term => "Taxonomy term",
    PropertyKind.Lookup => "Item of a list",
    _ => kind.ToString()
  }];

  // ------------------------------------------------------------------ preview

  /// <summary>The preview's form, rebuilt when the draft changes; values typed in it carry over.</summary>
  private ContentEditorState Preview
  {
    get
    {
      var snapshot = _s!.ToSnapshot();
      var signature = JsonSerializer.Serialize(snapshot, Json);
      if (_preview is null || signature != _previewSignature)
      {
        JsonElement? content = _preview is null ? null : JsonSerializer.SerializeToElement(_preview.Content());
        JsonElement? style = _preview is null ? null : JsonSerializer.SerializeToElement(_preview.Style());
        _preview = new ContentEditorState(snapshot, content, style);
        _previewSignature = signature;
        _previewIssues = [];
      }
      return _preview;
    }
  }

  private static void PreviewChanged() { } // the event alone re-renders the page

  private void CheckPreview() => _previewIssues = Preview.MissingRequired().ToDictionary(i => i.Path, i => i.Message);

  /// <summary>
  /// The preview's values as schema.org JSON-LD, built by the server (POST /content/jsonld) from the draft as it is now,
  /// with ‹label› for what is empty. Asked again a moment after the draft or the values stop changing.
  /// </summary>
  private string? _jsonLd;
  private string? _jsonLdSignature;
  private CancellationTokenSource? _jsonLdWait;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_s is null || _catalog is null) return;
    var state = Preview;
    var draft = _s.ToDraft();
    var content = state.Content();
    var signature = JsonSerializer.Serialize(draft, Json) + "|" + content.ToJsonString();
    if (signature == _jsonLdSignature) return;
    _jsonLdSignature = signature;

    _jsonLdWait?.Cancel();
    var wait = _jsonLdWait = new CancellationTokenSource();
    try
    {
      await Task.Delay(_jsonLd is null ? 0 : 400, wait.Token);
      var report = await Api.BuildJsonLdAsync(new JsonLdRequest
      {
        Root = new ContentNode
        {
          Field = _s.Key.Trim().Length > 0 ? _s.Key.Trim() : "new-field",
          FieldVersion = 0,
          Content = JsonSerializer.SerializeToElement(content),
          Style = JsonSerializer.SerializeToElement(state.Style())
        },
        Draft = draft,
        Placeholders = true
      }, wait.Token);
      if (wait.IsCancellationRequested) return;
      _jsonLd = JsonSerializer.Serialize(report.JsonLd, Json);
    }
    catch (OperationCanceledException) { return; }
    catch (Exception ex)
    {
      _jsonLd = L["The schema.org data could not be built: {0}", Describe(ex)];
    }
    StateHasChanged();
  }

  // ------------------------------------------------------------------ JSON tab

  private void OpenJson()
  {
    _jsonText = JsonSerializer.Serialize(_s!.ToDraft(), Json);
    _jsonTab = true;
  }

  private void ApplyJson()
  {
    try
    {
      var draft = JsonSerializer.Deserialize<FieldDraft>(_jsonText, Json);
      if (draft is null) return;
      _s = FieldBuilderState.From(_s!.Key, draft);
      _jsonTab = false;
      Error = null;
    }
    catch (JsonException ex)
    {
      Error = L["The draft is not valid JSON: {0}", ex.Message];
    }
  }

  // ------------------------------------------------------------------ saving

  private async Task<bool> SaveAsync()
  {
    if (_s is null) return false;
    if (_s.CanBeRoot && !_s.UrlPrefixIsValid)
    {
      Error = L["A URL prefix is lowercase letters, digits and single hyphens, with \"/\" between its parts and none at either end."];
      return false;
    }
    var draft = _s.ToDraft();
    return await RunAsync(async () =>
    {
      if (_detail is null)
      {
        _detail = await Api.CreateFieldAsync(new NewField { Key = _s.Key.Trim(), Draft = draft });
        _s = FieldBuilderState.From(_detail.Key, _detail.Draft);
        _savedSignature = Signature();
        await MudTail.ToastAsync(L["Field {0} created.", _detail.Key], "success");
        Nav.NavigateTo($"dynamicfields/build?key={Uri.EscapeDataString(_detail.Key)}", replace: true);
      }
      else
      {
        _detail = await Api.EditFieldDraftAsync(_detail.Key, new DraftEdit { Version = _detail.Version, Draft = draft });
        _savedSignature = Signature();
        await MudTail.ToastAsync(L["Draft of {0} saved.", _detail.Key], "success");
      }
    });
  }

  private async Task PublishAsync()
  {
    if (_detail is null) return;
    if (_s is { CanBeRoot: true } && string.IsNullOrWhiteSpace(_s.UrlPrefix))
    {
      Error = L["A post field needs its URL prefix before it is published."];
      return;
    }
    if (Dirty && !await SaveAsync()) return;
    var detail = _detail;
    await RunAsync(async () =>
    {
      var published = await Api.PublishFieldAsync(detail.Key, new PublishRequest { Version = detail.Version });
      await MudTail.ToastAsync(L["{0} version {1} published.", detail.Key, published.Field.Version], "success");
      _detail = await Api.GetFieldAsync(detail.Key);
    });
  }

  private async Task DeleteAsync()
  {
    if (_detail is not { } detail) return;
    await RunAsync(async () =>
    {
      await Api.DeleteFieldAsync(detail.Key, detail.Version);
      await MudTail.ToastAsync(L["Field {0} deleted.", detail.Key], "success");
      Nav.NavigateTo("dynamicfields");
    });
  }

  /// <summary>Opens the edit dialog by its id, as another module would, with the last result as its content.</summary>
  private async Task TryEditorAsync()
  {
    if (_detail is not { } detail) return;
    JsonElement? content = null, style = null;
    string? nodeId = null;
    if (_tried is not null)
    {
      using var last = JsonDocument.Parse(_tried);
      content = last.RootElement.GetProperty("content").Clone();
      style = last.RootElement.GetProperty("style").Clone();
      nodeId = last.RootElement.TryGetProperty("nodeId", out var id) ? id.GetString() : null;
    }
    var result = await ModuleDialogs.ShowAsync("Module.DynamicFields/edit-content", new { field = detail.Key, content, style, nodeId });
    if (result.Canceled) await MudTail.ToastAsync(L["The editor was canceled."], "info");
    else _tried = JsonSerializer.Serialize(result.Data, Json);
  }

  /// <summary>Opens the translate dialog by its id, as Contents would: the tried content as the root, into the other language.</summary>
  private async Task TryTranslationAsync()
  {
    if (_tried is null) return;
    using var last = JsonDocument.Parse(_tried);
    var tried = last.RootElement;
    var root = new { field = tried.GetProperty("field").GetString(), fieldVersion = tried.GetProperty("version").GetInt32(),
      content = tried.GetProperty("content").Clone(), style = tried.GetProperty("style").Clone() };
    var language = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "en" : "ar";
    JsonElement? translation = _translated is null ? null : JsonDocument.Parse(_translated).RootElement.Clone();
    var result = await ModuleDialogs.ShowAsync("Module.DynamicFields/translate-content", new { root, language, translation });
    if (!result.Canceled) _translated = JsonSerializer.Serialize(result.Data, Json);
  }
}
