@attribute [ClientDialog("Module.DynamicFields/edit-content", Title = "Edit content", MaxWidth = "720px")]
@using System.Text.Json
@using soft.square.net.Module.DynamicFields.Dialogs
@inherits DynamicFieldsPageBase

@*
  Dialog "Module.DynamicFields/edit-content": edits one content node with the form its field defines. For any module
  (IModuleDialogs.ShowAsync); the Contents editor opens it for each node of a post.
    parameters  { field: "block.image", version?: number (0 or none: the newest), content?: {...}, style?: {...} }
    result      { field, version, content, style }   checked by the server before the dialog closes
  The form itself is ContentEditorForm, which the field builder also shows as its preview.
*@

<div class="mud-dialog-content df-editor">
  @if (_state is null)
  {
    <p class="mud-typography mud-typography-body2 mn-muted">@(Error ?? "Loading the field…")</p>
  }
  else
  {
    <ContentEditorForm State="_state" Issues="_issues" OtherIssues="OtherIssues" StyleOpen="_styleOpen" />
  }
</div>
<div class="mud-dialog-actions">
  <button type="button" class="mud-button-root mud-button-text mud-button-medium" @onclick="Dialog.Cancel">@L["Cancel"]</button>
  <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium"
          disabled="@(_state is null || Busy)" @onclick="SaveAsync">@L["Save"]</button>
</div>

@code {
  [CascadingParameter] public IDialogReference Dialog { get; set; } = default!;

  /// <summary>The caller's parameters (web JSON).</summary>
  private sealed record Parameters(string? Field, int? Version, JsonElement? Content, JsonElement? Style);

  private ContentEditorState? _state;
  private Dictionary<string, string> _issues = [];
  private List<string> _otherIssues = [];
  private bool _styleOpen;

  private IReadOnlyList<string> OtherIssues => Error is null ? _otherIssues : [Error, .. _otherIssues];

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    var parameters = Dialog.GetParameters<Parameters>();
    if (string.IsNullOrWhiteSpace(parameters?.Field))
    {
      Error = L["No field to edit: open the dialog with {{ field: \"<key>\" }}."];
      StateHasChanged();
      return;
    }
    await RunAsync(async () =>
    {
      var version = await Api.GetFieldVersionAsync(parameters.Field, parameters.Version ?? 0);
      _state = new ContentEditorState(version.Field, parameters.Content, parameters.Style);
      _styleOpen = parameters.Style is { ValueKind: JsonValueKind.Object } style && style.EnumerateObject().Any();
    }, toast: false);
  }

  private async Task SaveAsync()
  {
    if (_state is null) return;
    var content = _state.Content();
    var style = _state.Style();
    _issues = [];
    _otherIssues = [];

    // Required values first, without a round trip; then the server's check, which is the one that counts.
    foreach (var (path, message) in _state.MissingRequired()) _issues[path] = message;
    if (_issues.Count > 0) return;

    ContentReport? report = null;
    var checkedOk = await RunAsync(async () => report = await Api.ValidateNodeAsync(new NodeValues
    {
      Field = _state.Field.Key,
      FieldVersion = _state.Field.Version,
      Content = JsonSerializer.SerializeToElement(content),
      Style = JsonSerializer.SerializeToElement(style)
    }), toast: false);
    if (!checkedOk || report is null) return;

    if (!report.Valid)
    {
      foreach (var issue in report.Issues)
      {
        var at = _state.OwnerPath(issue.Path);
        if (at is null) _otherIssues.Add($"{issue.Path}: {issue.Message}");
        else _issues.TryAdd(at, issue.Message);
        if (issue.Path.StartsWith("/style", StringComparison.Ordinal)) _styleOpen = true;
      }
      return;
    }

    Dialog.Close(new { field = _state.Field.Key, version = _state.Field.Version, content, style });
  }
}
