@using soft.square.net.Module.DynamicFields.Dialogs
@using soft.square.net.ModularBlazor.Abstractions.Lookups
@inject IModuleDialogs ModuleDialogs
@inject IStringLocalizer<ContentEditorForm> L

@*
  The form of one content node: a control per value of the field and a select per style. The edit-content dialog shows
  it around a published version; the field builder shows it as a live preview of a draft. Issues are keyed by owner path
  (/content/{key}, /style/{key}).
  Asset, Keyword and Term values get a "Choose" button when the user's catalog has a picker dialog for them, called with
  { multiple, selected: [ids], accept } and answering { ids: [...], files? }:
  - Asset: Module.Media/pick-asset when a media module is installed, else the Storage module's file browser
    (Module.Storage/pick-files), limited to the property's accept list (image/*, video/*, .pdf, ...). The files it
    answers with are shown by name, images as a thumbnail when they have a public address;
  - Keyword: Module.Keywords/pick-concepts; Term: Module.Taxonomies/pick-terms.
  Without one, the id is typed.
  Lookup values use the platform's lookup controls (the module that owns the lookup answers): an autocomplete (chips
  when multiple, filtered by its parent property's value when dependent), a picker with filter chips, or a cascade of
  autocompletes for a recursive lookup.
*@

<p class="mud-typography mud-typography-body2 mn-muted df-editor-type">
  @State.Field.Title · schema.org <strong>@State.Field.SchemaType</strong> · @State.Field.Key@(State.Field.Version > 0 ? $" v{State.Field.Version}" : "")
</p>
@if (State.Field.Description is { Length: > 0 } description)
{
  <p class="mud-typography mud-typography-body2">@description</p>
}
@if (State.Values.Count == 0 && State.Styles.Count == 0)
{
  <p class="mud-typography mud-typography-body2 mn-muted">@L["This field has no values or style yet."]</p>
}

@foreach (var value in State.Values)
{
  var p = value.Property;
  var id = $"df-{_uid}-{p.Key}";
  <div class="mud-input-control df-value @(IssueFor($"/content/{p.Key}") is not null ? "mud-input-error" : "")" @key="value">
    @if (value.IsLookup && value.Lookup is { } lookup)
    {
      <label class="mud-input-label" for="@id">@p.Label@(value.Required ? " *" : "")</label>
      <div id="@id">
        @if (lookup.Recursive == true)
        {
          <LookupCascade Lookup="@lookup.Key" RootKey="@lookup.RootKey" MaxDepth="@(lookup.MaxDepth ?? 5)" LeafOnly="@(lookup.LeafOnly == true)"
                         MinChars="@(lookup.MinChars ?? 0)" Path="@value.Path" PathChanged="path => value.Path = path" />
        }
        else if (lookup.Mode == LookupMode.Picker)
        {
          <LookupPicker Lookup="@lookup.Key" Multiple="@value.Multiple" MaxSelections="@lookup.MaxSelections" PresetFilters="@Filters(lookup)"
                        AllowUserFilters="@(lookup.AllowUserFilters == true)" Selected="@value.Selection" SelectedChanged="items => Pick(value, items)" />
        }
        else
        {
          var parentKey = State.ParentKey(value);
          var waiting = lookup.ParentProperty is not null && parentKey is null;
          <LookupAutocomplete Lookup="@lookup.Key" Fields="@lookup.SearchFields" Parent="@parentKey" Filters="@Filters(lookup)"
                              MinChars="@(lookup.MinChars ?? 0)" Multiple="@value.Multiple" Disabled="@waiting"
                              Placeholder="@(waiting ? L["Choose {0} first", ParentLabel(lookup)].Value : null)"
                              Value="@value.Picked" ValueChanged="item => Pick(value, item is null ? [] : [item])"
                              Values="@value.Picks" ValuesChanged="items => Pick(value, items)" />
        }
      </div>
    }
    else if (p.Kind == PropertyKind.Boolean && !value.Multiple)
    {
      <label class="mn-check"><input id="@id" type="checkbox" @bind="value.Flag" /> @p.Label</label>
    }
    else
    {
      <label class="mud-input-label" for="@id">@p.Label@(value.Required ? " *" : "")</label>
      @if (value.IsChoice && value.Multiple)
      {
        <div class="df-choices" id="@id">
          @foreach (var option in p.Options ?? [])
          {
            <label class="mn-check">
              <input type="checkbox" checked="@value.Items.Contains(option)" @onchange="e => Toggle(value, option, e.Value is true)" /> @option
            </label>
          }
        </div>
      }
      else if (value.Multiple)
      {
        @for (var i = 0; i < value.Items.Count; i++)
        {
          var index = i;
          <div class="df-item">
            <div class="mud-input-wrapper mud-input-wrapper--dense">
              <input id="@(index == 0 ? id : null)" class="mud-input-slot" type="@InputType(p.Kind)" step="@Step(p.Kind)" maxlength="@p.MaxLength"
                     value="@value.Items[index]" @onchange="e => value.Items[index] = e.Value?.ToString() ?? string.Empty" placeholder="@Placeholder(p.Kind)" />
            </div>
            <button type="button" class="mud-button-root mud-button-text mud-button-small" aria-label="@L["Remove"]" @onclick="() => value.Items.RemoveAt(index)">✕</button>
          </div>
          @if (p.Kind == PropertyKind.Asset && FileOf(value.Items[index]) is { } file)
          {
            <FileChip File="file" />
          }
        }
        <div class="df-item-actions">
          <button type="button" class="mud-button-root mud-button-text mud-button-primary mud-button-small" @onclick="() => value.Items.Add(string.Empty)">@L["Add"]</button>
          @if (PickerFor(p.Kind) is { } picker)
          {
            <button type="button" class="mud-button-root mud-button-text mud-button-primary mud-button-small" @onclick="() => PickAsync(value, picker)">@L["Choose…"]</button>
          }
        </div>
      }
      else if (value.IsChoice)
      {
        <div class="mud-input-wrapper mud-input-wrapper--select">
          <select id="@id" class="mud-input-slot" @bind="value.Text">
            <option value="">@(value.Required ? "Choose…" : "—")</option>
            @foreach (var option in p.Options ?? [])
            {
              <option value="@option">@option</option>
            }
          </select>
        </div>
      }
      else if (p.Kind == PropertyKind.RichText)
      {
        <div class="mud-input-wrapper">
          <textarea id="@id" class="mud-input-slot mn-body" rows="6" maxlength="@p.MaxLength" @bind="value.Text"></textarea>
        </div>
      }
      else
      {
        <div class="df-item">
          <div class="mud-input-wrapper">
            <input id="@id" class="mud-input-slot" type="@InputType(p.Kind)" step="@Step(p.Kind)" maxlength="@p.MaxLength"
                   min="@p.Minimum" max="@p.Maximum" @bind="value.Text" placeholder="@Placeholder(p.Kind)" />
          </div>
          @if (PickerFor(p.Kind) is { } picker)
          {
            <button type="button" class="mud-button-root mud-button-text mud-button-primary mud-button-small" @onclick="() => PickAsync(value, picker)">@L["Choose…"]</button>
          }
        </div>
        @if (p.Kind == PropertyKind.Asset && FileOf(value.Text) is { } file)
        {
          <FileChip File="file" />
        }
      }
    }
    @if (IssueFor($"/content/{p.Key}") is { } issue)
    {
      <div class="mud-input-helper-text mn-error" role="alert">@issue</div>
    }
    else if (Help(p) is { Length: > 0 } help)
    {
      <div class="mud-input-helper-text">@help</div>
    }
  </div>
}

@if (State.Styles.Count > 0)
{
  <details class="df-style" open="@StyleOpen">
    <summary class="mud-typography mud-typography-subtitle2">@L["Style"]</summary>
    @foreach (var style in State.Styles)
    {
      var s = style.Property;
      var id = $"df-{_uid}-style-{s.Key}";
      <div class="mud-input-control df-value" @key="style">
        <label class="mud-input-label" for="@id">@s.Label</label>
        <div class="mud-input-wrapper mud-input-wrapper--select">
          <select id="@id" class="mud-input-slot" @bind="style.Base">
            <option value="">@(s.Default is { } d ? L["Default ({0})", d] : L["Default"])</option>
            @foreach (var token in s.Values)
            {
              <option value="@token">@token</option>
            }
          </select>
        </div>
        @if (style.Responsive)
        {
          <label class="mn-check"><input type="checkbox" @bind="style.ByBreakpoint" /> @L["Different on wider screens"]</label>
          @if (style.ByBreakpoint)
          {
            <div class="df-breakpoints">
              @foreach (var point in ContentEditorState.StyleState.Breakpoints)
              {
                <label class="df-breakpoint">
                  <span>@point</span>
                  <select class="mud-input-slot" value="@style.PerBreakpoint.GetValueOrDefault(point, "")"
                          @onchange="e => style.PerBreakpoint[point] = e.Value?.ToString() ?? string.Empty">
                    <option value="">@L["as smaller"]</option>
                    @foreach (var token in s.Values)
                    {
                      <option value="@token">@token</option>
                    }
                  </select>
                </label>
              }
            </div>
          }
        }
        @if (IssueFor($"/style/{s.Key}") is { } issue)
        {
          <div class="mud-input-helper-text mn-error" role="alert">@issue</div>
        }
      </div>
    }
  </details>
}

@if (OtherIssues.Count > 0)
{
  <div class="mn-error" role="alert">
    @foreach (var issue in OtherIssues) { <p>@issue</p> }
  </div>
}

@code {
  /// <summary>The values and style being edited.</summary>
  [Parameter, EditorRequired] public ContentEditorState State { get; set; } = default!;

  /// <summary>Issues by owner path: /content/{key} or /style/{key}.</summary>
  [Parameter] public IReadOnlyDictionary<string, string> Issues { get; set; } = new Dictionary<string, string>();

  /// <summary>Issues that belong to no single value.</summary>
  [Parameter] public IReadOnlyList<string> OtherIssues { get; set; } = [];

  /// <summary>Whether the style section starts open.</summary>
  [Parameter] public bool StyleOpen { get; set; }

  /// <summary>The ids a picker dialog answers with, and (Storage's file browser) the files they are.</summary>
  private sealed record Picked(IReadOnlyList<string>? Ids, IReadOnlyList<PickedFile>? Files);

  /// <summary>The files picked in this form, by id: what an Asset value shows beside its id.</summary>
  private readonly Dictionary<string, PickedFile> _files = new(StringComparer.Ordinal);

  private PickedFile? FileOf(string? id) => id is { Length: > 0 } ? _files.GetValueOrDefault(id.Trim()) : null;

  private readonly string _uid = Guid.NewGuid().ToString("n")[..8];

  private string? IssueFor(string path) => Issues.GetValueOrDefault(path);

  private static void Toggle(ContentEditorState.ValueState value, string option, bool on)
  {
    value.Items.Remove(option);
    if (on) value.Items.Add(option);
  }

  private async Task PickAsync(ContentEditorState.ValueState value, string picker)
  {
    var selected = value.Multiple ? value.Items.Where(i => i.Trim().Length > 0).ToArray() : value.Text.Trim().Length > 0 ? [value.Text.Trim()] : [];
    var accept = value.Property.Kind == PropertyKind.Asset ? value.Property.Accept : null;
    var result = await ModuleDialogs.ShowAsync(picker, new { multiple = value.Multiple, selected, accept });
    if (result.Canceled || result.As<Picked>() is not { Ids: { } ids } picked) return;
    foreach (var file in picked.Files ?? [])
      if (file.Id is { Length: > 0 }) _files[file.Id] = file;

    if (value.Multiple)
    {
      value.Items.Clear();
      value.Items.AddRange(ids);
      if (value.Items.Count == 0) value.Items.Add("");
    }
    else value.Text = ids.FirstOrDefault() ?? "";
  }

  private void Pick(ContentEditorState.ValueState value, IReadOnlyList<LookupItem> items)
  {
    if (value.Lookup?.MaxSelections is { } most && items.Count > most) items = items.Take(most).ToList();
    var before = value.Multiple ? string.Join("|", value.Picks.Select(i => i.Key)) : value.Picked?.Key;
    if (value.Multiple) value.Picks = items;
    else value.Picked = items.FirstOrDefault();
    var after = value.Multiple ? string.Join("|", value.Picks.Select(i => i.Key)) : value.Picked?.Key;
    if (before != after) State.ClearDependents(value);
  }

  private static IReadOnlyList<LookupFilter>? Filters(LookupBinding lookup) =>
    lookup.PresetFilters is { Count: > 0 } filters ? filters.Select(f => new LookupFilter(f.Field, f.Op, f.Value, f.Values)).ToList() : null;

  private string ParentLabel(LookupBinding lookup) =>
    State.Values.FirstOrDefault(v => v.Property.Key == lookup.ParentProperty)?.Property.Label ?? lookup.ParentProperty ?? "";

  /// <summary>The picker dialogs of a kind, the preferred first: a media module's asset picker before Storage's files.</summary>
  private static string[] Pickers(PropertyKind kind) => kind switch
  {
    PropertyKind.Asset => ["Module.Media/pick-asset", "Module.Storage/pick-files"],
    PropertyKind.Keyword => ["Module.Keywords/pick-concepts"],
    PropertyKind.Term => ["Module.Taxonomies/pick-terms"],
    _ => []
  };

  /// <summary>The first picker of the kind the user's catalog has, or null (the id is typed).</summary>
  private string? PickerFor(PropertyKind kind) => Pickers(kind).FirstOrDefault(ModuleDialogs.IsAvailable);

  private static string InputType(PropertyKind kind) => kind switch
  {
    PropertyKind.Integer or PropertyKind.Decimal => "number",
    PropertyKind.Date => "date",
    PropertyKind.DateTime => "datetime-local",
    PropertyKind.Url => "url",
    _ => "text"
  };

  private static string? Step(PropertyKind kind) => kind switch
  {
    PropertyKind.Integer => "1",
    PropertyKind.Decimal => "any",
    _ => null
  };

  private string? Placeholder(PropertyKind kind) => kind switch
  {
    PropertyKind.Url => "https://…",
    PropertyKind.Asset => L["file id"],
    PropertyKind.Keyword => L["keyword id"],
    PropertyKind.Term => L["term id"],
    _ => null
  };

  private string? Help(FieldProperty p)
  {
    var parts = new List<string>();
    if (p.HelpText is { Length: > 0 } help) parts.Add(help);
    if (p.MaxLength is { } max) parts.Add(L["Up to {0} characters.", max]);
    if (p.Minimum is { } min && p.Maximum is { } top) parts.Add($"{min} to {top}.");
    if (p.SchemaProperty is { Length: > 0 } schema) parts.Add($"schema.org: {schema}");
    return string.Join(" ", parts);
  }
}
