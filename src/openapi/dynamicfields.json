{
  "openapi": "3.1.1",
  "info": {
    "title": "DynamicFields",
    "description": "DynamicFields: reusable, versioned content fields (schema.org types, values, style tokens, allowed children) and validation of content trees made with them.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/dynamicfields/fields": {
      "get": {
        "tags": [
          "Fields"
        ],
        "summary": "One page of fields by key; canBeRoot=true lists the fields a post can be made of.",
        "operationId": "DynamicFields_ListFields",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "canBeRoot",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldPage"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Fields"
        ],
        "operationId": "DynamicFields_CreateField",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewField"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldDetailDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/dynamicfields/fields/{key}": {
      "get": {
        "tags": [
          "Fields"
        ],
        "operationId": "DynamicFields_GetField",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldDetailDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Fields"
        ],
        "summary": "Delete a field that was never published.",
        "operationId": "DynamicFields_DeleteField",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/dynamicfields/fields/{key}/versions/{number}": {
      "get": {
        "tags": [
          "Fields"
        ],
        "summary": "A published field version; number 0 is the newest.",
        "operationId": "DynamicFields_GetFieldVersion",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldVersionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/dynamicfields/fields/{key}/draft": {
      "put": {
        "tags": [
          "Fields"
        ],
        "operationId": "DynamicFields_EditFieldDraft",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftEdit"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldDetailDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/dynamicfields/fields/{key}/publish": {
      "post": {
        "tags": [
          "Fields"
        ],
        "summary": "Publish the draft as the next version; each child is pinned to its newest published version.",
        "operationId": "DynamicFields_PublishField",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldVersionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/dynamicfields/content/validate": {
      "post": {
        "tags": [
          "Content"
        ],
        "summary": "Check a content tree against its published fields; every problem comes back with a JSON Pointer.",
        "operationId": "DynamicFields_ValidateContent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContentTree"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentReport"
                }
              }
            }
          }
        }
      }
    },
    "/api/dynamicfields/content/validate-node": {
      "post": {
        "tags": [
          "Content"
        ],
        "summary": "Check one node's content and style against its field version (what the edit dialog checks).",
        "operationId": "DynamicFields_ValidateNode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NodeValues"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentReport"
                }
              }
            }
          }
        }
      }
    },
    "/api/dynamicfields/content/translations/check": {
      "post": {
        "tags": [
          "Content"
        ],
        "summary": "List a content tree's translatable values and check a translation overlay against it.",
        "operationId": "DynamicFields_CheckTranslation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranslationCheck"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslationReport"
                }
              }
            }
          }
        }
      }
    },
    "/api/dynamicfields/content/translations/apply": {
      "post": {
        "tags": [
          "Content"
        ],
        "summary": "Merge translation overlays onto a content tree for a reader's culture, with fallback to the source.",
        "operationId": "DynamicFields_ApplyTranslations",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranslationMerge"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalizedContent"
                }
              }
            }
          }
        }
      }
    },
    "/api/dynamicfields/content/jsonld": {
      "post": {
        "tags": [
          "Content"
        ],
        "summary": "Build a post's schema.org JSON-LD from its kind and its contents, in reading order.",
        "operationId": "DynamicFields_BuildJsonLd",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonLdRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonLdReport"
                }
              }
            }
          }
        }
      }
    },
    "/api/dynamicfields/catalog/schema-org": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "The curated schema.org types (with their properties and suggestions) and the style presets.",
        "operationId": "DynamicFields_GetSchemaOrgCatalog",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaOrgCatalogDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/dynamicfields/catalog/root-post-fields": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "The published root post fields (the post kinds) by key, each with its URL prefix: the public route prefix of its posts.",
        "operationId": "DynamicFields_ListRootPostFields",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RootPostFieldDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/dynamicfields/catalog/starter-fields": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "The starter library: ready-made blocks and posts; installed = the tenant has a field with that key.",
        "operationId": "DynamicFields_ListStarterFields",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StarterFieldDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/dynamicfields/catalog/starter-fields/install": {
      "post": {
        "tags": [
          "Catalog"
        ],
        "summary": "Install starter fields (none given: all) with their children, published as version 1; existing keys are skipped.",
        "operationId": "DynamicFields_InstallStarterFields",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StarterInstall"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StarterInstallReport"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChildRule": {
        "required": [
          "fieldKey"
        ],
        "type": "object",
        "properties": {
          "fieldKey": {
            "type": "string"
          },
          "min": {
            "type": "integer",
            "format": "int32",
            "default": 0
          },
          "max": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "ContentIssue": {
        "required": [
          "path",
          "message"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ContentNode": {
        "required": [
          "field",
          "fieldVersion",
          "content",
          "style"
        ],
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "fieldVersion": {
            "type": "integer",
            "format": "int32"
          },
          "content": {
            "$ref": "#/components/schemas/JsonElement"
          },
          "style": {
            "$ref": "#/components/schemas/JsonElement"
          },
          "children": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/ContentNode"
            }
          },
          "nodeId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ContentReport": {
        "required": [
          "valid",
          "issues"
        ],
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentIssue"
            }
          }
        }
      },
      "ContentTranslation": {
        "required": [
          "language",
          "nodes"
        ],
        "type": "object",
        "properties": {
          "language": {
            "type": "string"
          },
          "nodes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/components/schemas/TranslatedValue"
              }
            }
          }
        }
      },
      "ContentTree": {
        "required": [
          "root"
        ],
        "type": "object",
        "properties": {
          "root": {
            "$ref": "#/components/schemas/ContentNode"
          }
        }
      },
      "DraftEdit": {
        "required": [
          "version",
          "draft"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "draft": {
            "$ref": "#/components/schemas/FieldDraft"
          }
        }
      },
      "FieldDetailDto": {
        "required": [
          "key",
          "draft",
          "latestVersion",
          "hasDraftChanges",
          "versions",
          "createdBy",
          "createdAt",
          "updatedAt",
          "version"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "draft": {
            "$ref": "#/components/schemas/FieldDraft"
          },
          "latestVersion": {
            "type": "integer",
            "format": "int32"
          },
          "hasDraftChanges": {
            "type": "boolean"
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldVersionInfo"
            }
          },
          "createdBy": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "FieldDraft": {
        "required": [
          "title",
          "schemaType",
          "canBeRoot",
          "properties",
          "style",
          "children"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "schemaType": {
            "type": "string"
          },
          "canBeRoot": {
            "type": "boolean"
          },
          "properties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldProperty"
            }
          },
          "style": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StyleProperty"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChildRule"
            }
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "editorDialog": {
            "type": [
              "null",
              "string"
            ]
          },
          "groups": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/PropertyGroup"
            }
          },
          "urlPrefix": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FieldPage": {
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldSummaryDto"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "FieldProperty": {
        "required": [
          "key",
          "label",
          "kind"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PropertyKind"
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "multiple": {
            "type": "boolean",
            "default": false
          },
          "schemaProperty": {
            "type": [
              "null",
              "string"
            ]
          },
          "helpText": {
            "type": [
              "null",
              "string"
            ]
          },
          "minLength": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "maxLength": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "minimum": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "maximum": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "options": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "translatable": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "lookup": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LookupBinding"
              }
            ]
          },
          "accept": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "group": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FieldSnapshot": {
        "required": [
          "key",
          "version",
          "title",
          "description",
          "schemaType",
          "canBeRoot",
          "properties",
          "style",
          "children",
          "editorDialog"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "schemaType": {
            "type": "string"
          },
          "canBeRoot": {
            "type": "boolean"
          },
          "properties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldProperty"
            }
          },
          "style": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StyleProperty"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PinnedChild"
            }
          },
          "editorDialog": {
            "type": [
              "null",
              "string"
            ]
          },
          "groups": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/PropertyGroup"
            }
          },
          "urlPrefix": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FieldSummaryDto": {
        "required": [
          "key",
          "title",
          "schemaType",
          "canBeRoot",
          "latestVersion",
          "hasDraftChanges",
          "updatedAt",
          "version"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "schemaType": {
            "type": "string"
          },
          "canBeRoot": {
            "type": "boolean"
          },
          "latestVersion": {
            "type": "integer",
            "format": "int32"
          },
          "hasDraftChanges": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "urlPrefix": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FieldVersionDto": {
        "required": [
          "field",
          "publishedAt",
          "publishedBy",
          "contentSchema",
          "styleSchema"
        ],
        "type": "object",
        "properties": {
          "field": {
            "$ref": "#/components/schemas/FieldSnapshot"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "publishedBy": {
            "type": "string"
          },
          "contentSchema": {
            "$ref": "#/components/schemas/JsonElement"
          },
          "styleSchema": {
            "$ref": "#/components/schemas/JsonElement"
          }
        }
      },
      "FieldVersionInfo": {
        "required": [
          "number",
          "publishedAt",
          "publishedBy"
        ],
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "publishedBy": {
            "type": "string"
          }
        }
      },
      "JsonElement": { },
      "JsonLdAsset": {
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "width": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "height": {
            "type": [
              "null",
