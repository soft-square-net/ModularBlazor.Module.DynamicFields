<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests of Core (aggregate rules) and UseCases (handlers, with NSubstitute for the repositories and the
       platform's IAccessScopes / IGrantStore). No database, no host. -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\WebApi.Modules.DynamicFields.Core\WebApi.Modules.DynamicFields.Core.csproj" />
    <ProjectReference Include="..\..\src\WebApi.Modules.DynamicFields.UseCases\WebApi.Modules.DynamicFields.UseCases.csproj" />
  </ItemGroup>

  <!-- A JSON Schema 2020-12 validator, to check the dialect and the compiled schemas against the standard (tests only;
       the module itself does not validate with JSON Schema yet). -->
  <ItemGroup>
    <!-- Behind an alias, with its dependencies: their root namespace, Json, would hide the Samples.Json helper the tests import. -->
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" Aliases="JsonSchemaNet" />
    <PackageReference Include="JsonPointer.Net" Version="7.0.2" Aliases="JsonSchemaNet" />
    <PackageReference Include="Json.More.Net" Version="3.0.1" Aliases="JsonSchemaNet" />
  </ItemGroup>

</Project>
